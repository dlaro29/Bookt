<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.books.BooksFragment">

    <TextView
        android:id="@+id/tvBooksTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Da leggere"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBooksSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="I libri che vuoi leggere in futuro"
        android:textColor="#666666"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/progressBarReading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvReadingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Caricamento libri..."
        android:textColor="#666666"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyReading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Non hai ancora aggiunto libri da leggere"
        android:textColor="#666666"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReadingBooks"
        android:layout_width="386dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        tools:listitem="@layout/item_saved_book" />

</LinearLayout>