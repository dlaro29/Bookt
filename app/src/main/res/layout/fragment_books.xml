<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp"
    tools:context=".ui.books.BooksFragment">

    <TextView
        android:id="@+id/tvBooksTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Da leggere"
        android:textColor="#BDBDBD"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBooksSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="La tua lista dei libri che vuoi leggere"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/progressBarReading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="34dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvReadingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Caricamento libri..."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyReading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:gravity="center"
        android:text="Non hai ancora aggiunto libri da leggere"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReadingBooks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        tools:listitem="@layout/item_saved_book" />

</LinearLayout>